# Copy this file to .env and fill in your own values.
# .env is gitignored — your token never leaves your machine.

# Your Canvas instance (no trailing slash)
CANVAS_BASE_URL=https://canvas.youruniversity.edu

# A personal access token from Canvas → Account → Settings → "New Access Token".
# This is YOUR token for YOUR data. The tool is read-only.
CANVAS_TOKEN=replace-with-your-token

# --- Rate limiting (human-paced; safe defaults, override only if you know why) ---
# Minimum / maximum random gap between requests, in seconds.
EASEL_MIN_INTERVAL=0.7
EASEL_MAX_INTERVAL=1.8
# Hard ceiling on requests per rolling 60s window.
EASEL_RPM=40

# Optional: the public library site (no login needed).
LIBRARY_BASE_URL=https://library.youruniversity.edu
